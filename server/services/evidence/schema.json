{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidencePackage",
  "type": "object",
  "properties": {
    "normalizedSignal": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "topic": { "type": "string" },
        "source": { "type": "string" },
        "signal_strength": { "type": "integer" },
        "sentiment": { "type": "string" }
      },
      "required": ["category", "topic", "source", "signal_strength", "sentiment"]
    },
    "originalSource": {
      "type": "string"
    },
    "signalSources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "aiInputs": {
      "type": "string"
    },
    "agentOutputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agentName": { "type": "string" },
          "vote": { "type": "string" },
          "confidence": { "type": "number" },
          "reasoning": { "type": "string" }
        },
        "required": ["agentName", "vote", "confidence", "reasoning"]
      }
    },
    "reasoning": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "consensus": {
      "type": "object",
      "properties": {
        "weightedScore": { "type": "number" },
        "weightedConfidence": { "type": "number" },
        "approvalProbability": { "type": "number" },
        "averagedReputation": { "type": "number" }
      },
      "required": ["weightedScore", "weightedConfidence", "approvalProbability", "averagedReputation"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "protocol": { "type": "string" },
        "protocolVersion": { "type": "string" },
        "release": { "type": "string" },
        "build": { "type": "string" }
      },
      "required": ["protocol", "protocolVersion", "release", "build"]
    },
    "modelVersion": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "promptHash": {
      "type": "string"
    },
    "agentIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provider": {
      "type": "string"
    },
    "cid": {
      "type": "string"
    },
    "sha256Hash": {
      "type": "string",
      "length": 64
    }
  },
  "required": [
    "normalizedSignal",
    "originalSource",
    "signalSources",
    "aiInputs",
    "agentOutputs",
    "reasoning",
    "confidence",
    "consensus",
    "metadata",
    "modelVersion",
    "timestamp",
    "promptHash",
    "agentIds",
    "provider",
    "cid",
    "sha256Hash"
  ]
}
